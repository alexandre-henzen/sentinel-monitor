{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=EAM_DB;Username=eam_user;Password=eam_password",
    "RedisConnection": "localhost:6379"
  },
  "Database": {
    "CommandTimeout": 30,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  },
  "Cache": {
    "DefaultExpirationMinutes": 30,
    "SlidingExpirationMinutes": 15,
    "ConnectionTimeoutSeconds": 30,
    "RequestTimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "EnableCacheWarmup": true,
    "EnableCacheCleanup": true
  },
  "Processing": {
    "ChannelCapacity": 5000,
    "MaxConcurrentBatches": 5,
    "MaxBatchSize": 500,
    "DatabaseBatchSize": 50,
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 2,
    "EnableBackgroundProcessing": true,
    "ProcessingTimeoutSeconds": 30
  },
  "Storage": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "DefaultBucket": "eam-screenshots",
    "UseHttps": false,
    "UrlExpiryMinutes": 60,
    "MaxUploadSizeBytes": 52428800,
    "DefaultTtlDays": 30,
    "EnableVersioning": true,
    "AutoCreateBucket": true,
    "ConnectionTimeout": 30,
    "RequestTimeout": 300
  },
  "ApiSettings": {
    "MaxPageSize": 100,
    "DefaultPageSize": 20,
    "EnableApiVersioning": true,
    "EnableRateLimiting": true
  },
  "Security": {
    "JwtSecretKey": "YourSecretKeyHere_ChangeInProduction_MustBeAtLeast32CharactersLong_ForSecurityReasons",
    "JwtIssuer": "EAM.API",
    "JwtAudience": "EAM.Clients",
    "JwtExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7,
    "JwtClockSkewMinutes": 5,
    "TokenRenewalThresholdMinutes": 15,
    "MaxLoginAttempts": 5,
    "LockoutTimeMinutes": 30,
    "EnableRateLimiting": true,
    "RateLimitPerMinute": 100,
    "EnableSecurityAudit": true,
    "DefaultAgentKey": "dev-agent-key-12345",
    "SessionLifetimeMinutes": 480,
    "EnableTwoFactor": false,
    "PasswordHashAlgorithm": "bcrypt",
    "PasswordHashWorkFactor": 12,
    "RequireHttps": true,
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200",
      "http://localhost:3000",
      "https://localhost:3000"
    ],
    "ApiKeys": {
      "dev-agent-key-12345": "Development Agent",
      "prod-agent-key-67890": "Production Agent"
    },
    "EnableAccessLog": true,
    "AccessLogRetentionDays": 90
  },
  "Telemetry": {
    "ServiceName": "EAM.API",
    "ServiceVersion": "5.0.0",
    "Environment": "Development",
    "JaegerEndpoint": "http://localhost:14268/api/traces",
    "PrometheusEndpoint": "http://localhost:9090/metrics",
    "EnableTracing": true,
    "EnableMetrics": true,
    "EnablePrometheus": false,
    "EnableStructuredLogging": true,
    "TracingSamplingRate": 1.0,
    "EnableAutoInstrumentation": true,
    "ExportTimeoutSeconds": 30,
    "MetricsCollectionIntervalSeconds": 10,
    "EnableDetailedMetrics": true,
    "EnablePerformanceLogs": true,
    "EnableDatabaseTracing": true,
    "EnableHttpTracing": true,
    "EnableCacheTracing": true
  },
  "ExternalServices": {
    "ActiveDirectoryEndpoint": "ldap://localhost:389",
    "TeamsGraphApiEndpoint": "https://graph.microsoft.com/v1.0",
    "EmailServiceEndpoint": "smtp://localhost:587"
  },
  "HealthCheck": {
    "TimeoutSeconds": 30,
    "EnableDetailedChecks": true,
    "EnableCaching": true,
    "CacheTimeoutSeconds": 30,
    "EnableMetrics": true,
    "EnableLogging": true,
    "CheckIntervalSeconds": 60
  },
  "Features": {
    "EnableSwagger": true,
    "EnableHealthChecks": true,
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false
  }
}