{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Extensions.Hosting": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AgentSettings": {
    "DataSyncInterval": 30,
    "ScreenshotInterval": 60,
    "EnableWebTracking": true,
    "EnableTeamsTracking": true,
    "EnableScreenshots": false
  },
  "ApiSettings": {
    "BaseUrl": "https://localhost:7001",
    "Timeout": 60,
    "RetryCount": 5,
    "RetryDelay": 2
  },
  "SecuritySettings": {
    "EncryptionKey": "dev-key-not-for-production",
    "UseHttps": false,
    "ValidateServerCertificate": false
  },
  "TelemetrySettings": {
    "EnableTelemetry": true,
    "JaegerEndpoint": "http://localhost:14268/api/traces",
    "PrometheusEndpoint": "http://localhost:9090/metrics"
  }
}