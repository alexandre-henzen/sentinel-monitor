{
  "name": "eam-web-client",
  "version": "5.0.0",
  "description": "Employee Activity Monitor Web Client - Angular 18 SPA",
  "keywords": [
    "angular",
    "spa",
    "employee-monitoring",
    "activity-monitor"
  ],
  "author": "EAM Development Team",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "analyze": "ng build --configuration production --stats-json && npx webpack-bundle-analyzer dist/stats.json"
  },
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@angular/service-worker": "^18.2.0",
    "@angular/material": "^18.2.0",
    "@angular/cdk": "^18.2.0",
    "primeng": "^18.0.0",
    "primeicons": "^7.0.0",
    "primeflex": "^3.3.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.0",
    "@swimlane/ngx-charts": "^20.5.0",
    "d3": "^7.9.0",
    "angular-oauth2-oidc": "^17.0.2",
    "ngx-toastr": "^19.0.0",
    "moment": "^2.30.1",
    "date-fns": "^3.6.0",
    "lodash": "^4.17.21",
    "uuid": "^10.0.0",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@angular-eslint/builder": "^18.0.0",
    "@angular-eslint/eslint-plugin": "^18.0.0",
    "@angular-eslint/eslint-plugin-template": "^18.0.0",
    "@angular-eslint/schematics": "^18.0.0",
    "@angular-eslint/template-parser": "^18.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/lodash": "^4.17.0",
    "@types/node": "^20.11.0",
    "@types/uuid": "^10.0.0",
    "@types/d3": "^7.4.3",
